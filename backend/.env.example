# Copy to .env and fill in real values. Nothing here is read at import time,
# only when app.config.get_settings() is first called, so the app can boot
# without QBO/Gemini credentials - those pieces just stay disabled/unusable
# until configured.

APP_ENV=development
TESTING=false

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=finz_pipeline

# Gemini - used to assist classification of ambiguous transactions (4.3).
# Leave blank to run on rule-based classification only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# QuickBooks Online - from your Intuit developer app (4.5/4.6).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=http://localhost:8000/api/qbo/callback
# Filled in automatically after you complete the OAuth connect flow once,
# or set manually if you already know your sandbox company's realm ID.
QBO_REALM_ID=

# Where the browser is sent back to after the OAuth callback (the frontend
# dev server's URL) - change this if the frontend runs on a different
# host/port than the Vite default.
FRONTEND_URL=http://localhost:5173

# A transaction syncs automatically once its classification confidence meets
# this bar (rule/vendor-directory matches are always 1.0); anything lower
# (e.g. a less-confident Gemini guess) needs human review first. See PDF 4.5
# ("safely classified").
AUTO_SYNC_CONFIDENCE_THRESHOLD=0.95
